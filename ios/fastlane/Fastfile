# fastlane Fastfile — NASDX iOS
# 三个核心 lane：
#   build         编译校验（模拟器 + 无签名），CI 每次 push 跑
#   match_init    首次引导：创建/同步证书与描述文件（只需跑一次）
#   beta          构建并上传 TestFlight
default_platform(:ios)

APP_IDENTIFIER = ENV.fetch("BUNDLE_IDENTIFIER", "com.nasdx.ios")
APPLE_ID       = ENV["APPLE_ID"]
TEAM_ID        = ENV["TEAM_ID"]

def ensure_project
  UI.message("Generating Xcode project via xcodegen")
  sh("xcodegen generate --spec project.yml --project NASDX.xcodeproj")
end

def ensure_api_key
  app_store_connect_api_key(
    key_id: ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"],
    issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
    key_content: ENV["APP_STORE_CONNECT_API_KEY_KEY"]
  )
end

def ensure_match(readonly)
  match(
    type: "appstore",
    git_url: ENV["FASTLANE_MATCH_GIT_URL"],
    git_basic_authorization: ENV["FASTLANE_MATCH_GIT_BASIC_AUTHORIZATION"],
    app_identifier: APP_IDENTIFIER,
    readonly: readonly
  )
end

platform :ios do
  desc "编译校验（模拟器 + 无签名），CI 每次 push 跑"
  lane :build do
    ensure_project
    setup_ci if ENV["CI"]
    xcodebuild(
      scheme: "NASDX",
      destination: "generic/platform=iOS Simulator",
      configuration: "Debug",
      xcargs: "CODE_SIGNING_ALLOWED=NO",
      clean: true
    )
  end

  desc "首次引导：创建/同步签名证书与描述文件（仅需跑一次）"
  lane :match_init do
    ensure_project
    ensure_api_key
    match(
      type: "development",
      git_url: ENV["FASTLANE_MATCH_GIT_URL"],
      git_basic_authorization: ENV["FASTLANE_MATCH_GIT_BASIC_AUTHORIZATION"],
      app_identifier: APP_IDENTIFIER,
      readonly: false
    )
    match(
      type: "appstore",
      git_url: ENV["FASTLANE_MATCH_GIT_URL"],
      git_basic_authorization: ENV["FASTLANE_MATCH_GIT_BASIC_AUTHORIZATION"],
      app_identifier: APP_IDENTIFIER,
      readonly: false
    )
  end

  desc "构建并上传 TestFlight"
  lane :beta do
    ensure_project
    setup_ci if ENV["CI"]
    ensure_api_key
    # 首次上传前若尚未 bootstrap，可把仓库 Secret MATCH_READONLY 临时设为 "false"
    readonly = ENV.fetch("MATCH_READONLY", "true") != "false"
    ensure_match(readonly)
    build_app(
      scheme: "NASDX",
      export_method: "app-store",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: {
          APP_IDENTIFIER => "match AppStore #{APP_IDENTIFIER}"
        }
      }
    )
    upload_to_testflight(
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
  end
end
